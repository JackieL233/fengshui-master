{
  "name": "fengshui-master-user-journey-evaluation-suite",
  "version": "1.0.0",
  "purpose": "Twenty user-centered forward tests for proactive current-situation readings across sparse, cross-domain, and high-stakes requests.",
  "evaluation_layers": {
    "runtime_structural_checks": [
      "create_brief and generate_report are invoked for every prompt",
      "required runtime domains, references, risk levels, and guardrails are asserted",
      "the provisional heading precedes follow-up prompts and respects the case question budget",
      "urgent cases stop symbolic analysis",
      "proactive report headings occur exactly once"
    ],
    "model_evaluator_criteria": [
      "must_include",
      "must_not_include",
      "evaluation_focus"
    ],
    "natural_language_grading_executed": false
  },
  "delivery_contract": {
    "mode": "provisional_first",
    "first_response_requirement": "provisional_current_posture_before_questions",
    "max_follow_up_questions": 3,
    "sparse_input_rule": "Lower confidence and name unknowns, but still provide a bounded useful reading before asking questions.",
    "required_sequence": [
      "urgent_safety_check",
      "provisional_current_posture",
      "known_basis",
      "favorable_now",
      "possible_friction_and_manifestations",
      "confirmation_and_refutation_signals",
      "immediate_low_risk_action",
      "prioritized_relevant_domains",
      "actions_72_hours_30_days_90_days",
      "monitoring_and_stop_conditions",
      "up_to_three_high_value_questions"
    ]
  },
