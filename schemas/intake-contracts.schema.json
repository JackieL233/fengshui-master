{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JackieL233/fengshui-master/schemas/intake-contracts.schema.json",
  "title": "FengShui Master Intake Contracts",
  "type": "object",
  "required": ["name", "version", "purpose", "delivery_defaults", "domains"],
  "properties": {
    "name": {
      "type": "string",
      "const": "fengshui-master-intake-contracts"
    },
    "version": { "type": "string" },
    "purpose": { "type": "string" },
    "delivery_defaults": { "$ref": "#/$defs/deliveryDefaults" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/domainContract" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "deliveryDefaults": {
      "type": "object",
      "description": "Provisional-first delivery semantics. Missing intake fields gate precise, personalized, or irreversible conclusions, never the initial bounded reading.",
      "required": [
        "mode",
        "headline_before_questions",
        "max_follow_up_questions",
        "follow_up_timing",
        "sparse_input_effect",
        "missing_input_gate",
        "initial_bounded_reading"
      ],
      "properties": {
        "mode": { "const": "provisional_first" },
        "headline_before_questions": { "const": true },
        "max_follow_up_questions": { "type": "integer", "const": 3 },
        "follow_up_timing": { "const": "after_initial_bounded_reading" },
        "sparse_input_effect": { "const": "lower_confidence_not_suppress_reading" },
        "missing_input_gate": {
          "type": "object",
          "description": "Backward-compatible required_inputs, ask_first_if_missing, and blocking_missing_inputs fields constrain conclusion precision and reversibility only.",
          "required": ["fields", "gates", "never_gates"],
          "properties": {
            "fields": {
              "const": ["required_inputs", "ask_first_if_missing", "blocking_missing_inputs"]
            },
            "gates": {
              "const": ["precise_conclusions", "personalized_conclusions", "irreversible_recommendations"]
            },
            "never_gates": { "const": ["initial_bounded_reading"] }
          },
          "additionalProperties": false
        },
        "initial_bounded_reading": {
          "type": "object",
          "required": ["required_when_topic_readable", "suppressed_only_by"],
          "properties": {
            "required_when_topic_readable": { "const": true },
            "suppressed_only_by": {
              "const": ["urgent_safety_stop", "no_readable_topic_after_one_concise_clarification"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "domainContract": {
      "type": "object",
      "required": [
        "domain",
        "summary",
        "required_inputs",
        "optional_inputs",
        "ask_first_if_missing",
        "blocking_missing_inputs",
        "assumption_allowed_inputs",
        "boundary_disclosures",
        "red_lines",
        "routing_hints"
      ],
      "properties": {
        "domain": { "type": "string" },
        "summary": { "type": "string" },
        "required_inputs": { "$ref": "#/$defs/stringList" },
        "optional_inputs": { "$ref": "#/$defs/stringList" },
        "ask_first_if_missing": {
          "description": "Backward-compatible precision inputs to request after the initial bounded reading; they do not force questionnaire-first delivery.",
          "$ref": "#/$defs/stringList"
        },
        "blocking_missing_inputs": {
          "description": "Inputs that block precise, personalized, or irreversible conclusions, never the initial bounded reading.",
          "$ref": "#/$defs/stringList"
        },
        "assumption_allowed_inputs": { "$ref": "#/$defs/stringList" },
        "boundary_disclosures": { "$ref": "#/$defs/stringList" },
        "red_lines": { "$ref": "#/$defs/stringList" },
        "routing_hints": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
