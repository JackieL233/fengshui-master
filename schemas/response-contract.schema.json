{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JackieL233/fengshui-master/schemas/response-contract.schema.json",
  "title": "FengShui Master Response Contract",
  "type": "object",
  "required": [
    "name",
    "version",
    "purpose",
    "proactive_defaults",
    "conversation_defaults",
    "required_sections",
    "high_stakes_disclosures",
    "answer_rules",
    "red_lines",
    "output_modes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "fengshui-master-response-contract"
    },
    "version": { "type": "string" },
    "purpose": { "type": "string" },
    "proactive_defaults": { "$ref": "#/$defs/proactiveDefaults" },
    "conversation_defaults": { "$ref": "#/$defs/conversationDefaults" },
    "required_sections": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/section" }
    },
    "high_stakes_disclosures": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/disclosure" }
    },
    "answer_rules": { "$ref": "#/$defs/stringList" },
    "red_lines": { "$ref": "#/$defs/stringList" },
    "output_modes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/outputMode" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "conversationDefaults": {
      "type": "object",
      "required": [
        "context_scope", "repeat_known_questions", "repeat_declined_questions",
        "question_budget_is_target", "follow_up_mode", "correction_policy",
        "freshness_policy", "no_new_evidence_policy", "consent_policy", "response_depth"
      ],
      "properties": {
        "context_scope": { "const": "explicit_current_conversation" },
        "repeat_known_questions": { "const": false },
        "repeat_declined_questions": { "const": false },
        "question_budget_is_target": { "const": false },
        "follow_up_mode": { "const": "changes_then_next_action" },
        "correction_policy": { "type": "string", "minLength": 20 },
        "freshness_policy": { "type": "string", "minLength": 20 },
        "no_new_evidence_policy": { "type": "string", "minLength": 20 },
        "consent_policy": { "type": "string", "minLength": 20 },
        "response_depth": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    },
    "proactiveDefaults": {
      "type": "object",
      "required": [
        "mode",
        "headline_before_questions",
        "max_follow_up_questions",
        "sparse_input_rule",
        "cross_domain_prioritization",
        "high_stakes_behavior",
        "unknown_domain_adaptation",
        "required_sequence"
      ],
      "properties": {
        "mode": { "const": "provisional_first" },
        "headline_before_questions": { "const": true },
        "max_follow_up_questions": { "const": 3 },
        "sparse_input_rule": { "type": "string", "minLength": 20 },
        "cross_domain_prioritization": { "type": "string", "minLength": 20 },
        "high_stakes_behavior": { "type": "string", "minLength": 20 },
        "unknown_domain_adaptation": { "type": "string", "minLength": 20 },
        "required_sequence": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "prefixItems": [
            { "const": "urgent_safety_and_reality_check" },
            { "const": "provisional_current_posture_headline" },
            { "const": "known_basis_and_uncertainty" },
            { "const": "favorable_conditions" },
            { "const": "possible_friction_and_likely_manifestations" },
            { "const": "confirmation_and_disconfirmation_signals" },
            { "const": "immediate_low_risk_action" },
            { "const": "cross_domain_priorities" },
            { "const": "action_horizons_and_monitoring" },
            { "const": "follow_up_questions" }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["name", "required", "applies_to", "purpose"],
      "properties": {
        "name": { "type": "string" },
        "required": { "type": "boolean" },
        "applies_to": { "$ref": "#/$defs/stringList" },
        "purpose": { "type": "string" }
      },
      "additionalProperties": false
    },
    "disclosure": {
      "type": "object",
      "required": ["trigger", "required_text", "professional_priority"],
      "properties": {
        "trigger": { "type": "string" },
        "required_text": { "type": "string" },
        "professional_priority": { "type": "string" }
      },
      "additionalProperties": false
    },
    "outputMode": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
